---
layout: null
permalink: /search.json
---
[
  {% assign sorted = site.notes | sort: "last_modified_at" | reverse %}
  {% for note in sorted %}
  {
    "title": {{ note.title | jsonify }},
    "url": "{{ site.baseurl }}{{ note.url }}",
    {% assign search_text = note.content | strip_html | normalize_whitespace %}
    "excerpt": {{ search_text | truncatewords: 30 | jsonify }},
    "text": {{ search_text | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
